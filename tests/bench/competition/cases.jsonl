{"id": "C113", "statement": "欧拉定理", "goal": "congruent(power(a, phi(m)), 1, m)", "premises": ["coprime(a, m)", "gt(m, 1)"]}
{"id": "C114", "statement": "费马小定理推论：a^p ≡ a", "goal": "congruent(power(a, p), a, p)", "premises": ["prime(p)"]}
{"id": "C115", "statement": "二项式系数 C(p,k) ≡ 0 mod p", "goal": "congruent(binomial(p,k), 0, p)", "premises": ["prime(p)", "gt(k, 0)", "lt(k, p)"]}
{"id": "C116", "statement": "Lucas 定理", "goal": "congruent(binomial(n,k), times(binomial(n0,k0), binomial(n1,k1)), p)", "premises": ["prime(p)", "equals(n, plus(n0, times(p,n1)))", "equals(k, plus(k0, times(p,k1)))", "lt(n0, p)", "lt(k0, p)"]}
{"id": "C117", "statement": "p 素数 ⇒ (p-1)! ≡ -1", "goal": "congruent(factorial(minus(p,1)), minus(0,1), p)", "premises": ["prime(p)"]}
{"id": "C118", "statement": "gcd(a,b) = gcd(b, a mod b)", "goal": "equals(gcd(a,b), gcd(b, mod(a,b)))", "premises": ["gt(b, 0)"]}
{"id": "C119", "statement": "欧几里得算法终止", "goal": "exists(n, equals(gcd_iter(a, b, n), gcd(a, b)))", "premises": ["gt(a, 0)", "gt(b, 0)"]}
{"id": "C120", "statement": "素数无穷多", "goal": "forall(N, exists(p, and(prime(p), gt(p, N))))", "premises": []}
